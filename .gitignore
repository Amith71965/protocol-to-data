# Data — never committed. Fetch with scripts/download_data.py (approx 100 MB).
# `data/*` rather than `data/` so git still descends and the gold-set negation applies.
data/*
!data/gold/

# Secrets
.env

# brag render output (videos) — excluded from git by project convention
brag-output/
brag-output-*/

# archify working directories
.archify/

# Generated reports are reproducible from the pipeline, so the bulky machine-readable
# ones stay out. The two prose reports the README cites are committed, so a reader can
# audit the coverage reasons and the extraction metrics without running anything.
reports/*.csv
reports/*.md
!reports/.gitkeep
!reports/coverage.md
!reports/extraction_metrics.md

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# OS / editor
.DS_Store

# Local preview config for rendering diagrams
.claude/

# Archify verification receipts (regenerated by `finalize`)
docs/diagrams/*.json
