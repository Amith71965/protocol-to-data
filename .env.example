# Copy to .env (gitignored) and fill in. Never commit real keys.

# --- LLM provider (Phase 4: eligibility-criteria extraction) ---
# Which adapter to use: "anthropic" or "openrouter"
P2D_LLM_PROVIDER=anthropic
P2D_LLM_MODEL=claude-opus-5

# Anthropic. Leave ANTHROPIC_BASE_URL unset to use the public API directly;
# set it only if you route through a gateway or proxy.
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=

# OpenRouter (alternative provider). Set P2D_LLM_PROVIDER=openrouter and give
# P2D_LLM_MODEL an OpenRouter slug; the adapter asks for a strict JSON schema,
# so pick a model whose supported_parameters include structured_outputs
# (e.g. anthropic/claude-sonnet-5.5, anthropic/claude-opus-5.5, openai/gpt-5.1).
# OPENROUTER_API_KEY=

# --- Pipeline behaviour ---
# When true (default), the extractor only reads cached responses and never
# makes a network call. Tests and CI always run with this on.
P2D_LLM_CACHE_ONLY=true
